# =============================================================================
# Repository policy
#
# Track only what is needed to build, test, or run the project. The only other
# tracked material is documentation and agent guidance:
#
#   README.md      project documentation
#   AGENTS.md      agent guidance
#   specs/         specifications and plans
#   docs/          decision records and design notes
#
# Everything else is ignored. When you add a new file, ask: does the project
# fail to build, test, or run without it? If not, add an ignore rule here.
#
# Tracked on purpose (no rule below may match these):
#   backend/            Python source
#   frontend/           React source
#   specs/              specifications
#   docs/               decision records and design notes
#   data.example/       sample master and postings used by tests and demos
#   pyproject.toml      Python dependencies and tooling config
#   uv.lock             locked Python dependency graph
#   package.json        frontend dependencies and scripts
#   pnpm-lock.yaml      locked frontend dependency graph
#   Makefile            dev / test / lint / build entry points
#   .github/workflows/  CI definition
#   .env.example        names of required environment variables
#   .gitignore          this file
# =============================================================================

# --- Agent tooling and local IDE workspace state ------------------------------
# Not needed to build or run the project; regenerated by each developer's tools.
.agents/
.opencode/
# Spec Kit: commit governance and tooling, ignore machine-local state.
# .specify/.gitignore excludes feature.json, extension local config, and
# installed integration packages on its own.
.specify/*
!.specify/memory/
!.specify/templates/
!.specify/scripts/
!.specify/workflows/
.cursor/
.claude/
.continue/
.windsurf/
.aider*
.agents-lock.json
skills-lock.json

# --- Documentation outside the tracked doc folders ---------------------------
*.md
!README.md
!AGENTS.md
!backend/**/*.md
!frontend/**/*.md
!specs/**/*.md
!docs/**/*.md
!.specify/**/*.md
!data.example/**/*.md

# --- Node / frontend build and cache output ----------------------------------
node_modules/
dist/
build/
coverage/
.vite/
.turbo/
.parcel-cache/
.next/
*.tsbuildinfo
.eslintcache
.stylelintcache
.prettiercache

# --- Python build and cache output -------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# --- Generated PDFs, reports, and run artifacts -------------------------------
outputs/
*.pdf

# --- Local configuration and secrets -----------------------------------------
.env
.env.*
!.env.example

# --- Local runtime data -------------------------------------------------------
*.log
logs/
*.db
*.db-*
*.sqlite
*.sqlite3
data/

# Personal profile data is never committed. The example schema is committed
# instead; developers copy it to profile/master.json locally.
profile/master.json
profile/master.json.bak.*

# --- Local agent workflow (not committed) -------------------------------------
# The durable planning state, its source routing, and the generated agent guide
# stay local, like the rest of the agent tooling.
.ub-workflows/
SOURCE_ATLAS.md
AGENTS.md

# --- Husky generated internals ------------------------------------------------
.husky/
.husky/_/

# --- OS / editor --------------------------------------------------------------
.DS_Store
Thumbs.db
.directory
.idea/
.vscode/
.zed/
.history/
*.swp
*.swo
*~

# --- Local tool caches --------------------------------------------------------
.cache/
.direnv/
.python-version
