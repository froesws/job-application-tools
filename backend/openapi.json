{
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "posting": {
            "minLength": 1,
            "title": "Posting",
            "type": "string"
          }
        },
        "required": [
          "posting"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RenderRequest": {
        "properties": {
          "origin_run_id": {
            "title": "Origin Run Id",
            "type": "string"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "selection": {
            "$ref": "#/components/schemas/Selection"
          }
        },
        "required": [
          "profile",
          "origin_run_id",
          "selection"
        ],
        "title": "RenderRequest",
        "type": "object"
      },
      "Selection": {
        "description": "The user's picks, by id only. The renderer never sees text from here.",
        "properties": {
          "experience": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Experience",
            "type": "object"
          },
          "language": {
            "enum": [
              "pt-BR",
              "en-US"
            ],
            "title": "Language",
            "type": "string"
          },
          "project_ids": {
            "items": {
              "type": "string"
            },
            "title": "Project Ids",
            "type": "array"
          },
          "research": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Research",
            "type": "object"
          },
          "research_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Research Ids"
          },
          "role_id": {
            "title": "Role Id",
            "type": "string"
          },
          "skill_priority": {
            "items": {
              "type": "string"
            },
            "title": "Skill Priority",
            "type": "array"
          },
          "summary_ids": {
            "items": {
              "type": "string"
            },
            "title": "Summary Ids",
            "type": "array"
          }
        },
        "required": [
          "language",
          "role_id",
          "summary_ids"
        ],
        "title": "Selection",
        "type": "object"
      },
      "TailorRequest": {
        "properties": {
          "language": {
            "default": "pt-BR",
            "enum": [
              "pt-BR",
              "en-US"
            ],
            "title": "Language",
            "type": "string"
          },
          "posting": {
            "minLength": 1,
            "title": "Posting",
            "type": "string"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          }
        },
        "required": [
          "posting",
          "profile"
        ],
        "title": "TailorRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
