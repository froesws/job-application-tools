# Development configuration. Copy to .env and fill the values.
# .env is git-ignored; never commit it.

# Provider keys. Only the providers you use need a value; a missing key for the
# active provider is a configuration error, not a crash.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Per-step chains, tried in order: provider:model,provider:model
ANALYZE_CHAIN=
TAILOR_CHAIN=

# Set to `fake` for tests and demos: no network, no key.
LLM_PROVIDER=

# Limits
CALL_TIMEOUT_S=60
RUN_BUDGET_S=300
VALIDATION_RETRIES=2
VOTE_RUNS=1

# The only origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173

# Prompt and answer logging. Off by default; enabling it prints a warning.
PROMPT_LOGGING=false
